# ---------------------------------------------------------
# MAURER EVENTS - ENVIRONMENT VARIABLES TEMPLATE
# ---------------------------------------------------------

# ===============================
# DATABASE
# ===============================
# Standard PostgreSQL URL: Neon pooled on Vercel or private PostgreSQL on Coolify.
# Use sslmode=require for external Neon; never disable TLS certificate checks.
# For migrations supply the direct (non-pooler) URL to db:migrate.
DATABASE_URL="postgres://user:password@host:port/db_name"

# ===============================
# STRIPE
# ===============================
# Stripe Secret Key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY="sk_test_..."
# Stripe Webhook Secret for validating events
STRIPE_WEBHOOK_SECRET="whsec_..."

# ===============================
# EMAIL (RESEND)
# ===============================
# API Key for sending emails via Resend
RESEND_API_KEY="re_..."
# Verified Resend sender; may use a separate verified domain for staging.
EMAIL_FROM="Maurer Events <servus@maurer-events.com>"
# Destination for contact requests; use an explicitly authorized test inbox on staging.
CONTACT_EMAIL="servus@maurer-events.com"

# ===============================
# CLOUDINARY
# ===============================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_PRESET="maurer-events-preset"

# ===============================
# AUTHENTICATION
# ===============================
# Comma-separated list of admin email addresses allowed to login
ADMIN_EMAILS="admin1@example.com,admin2@example.com"
# Random secret of at least 32 characters, used to hash one-time login codes.
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Key for encrypting staff tax IDs, social security numbers and IBANs (AES-256-GCM).
# Use a dedicated random value in production (mindestens 32 Zeichen). Kein Fallback auf AUTH_SECRET.
STAFF_DATA_KEY="replace-with-a-separate-random-key-of-at-least-32-characters"
# Explicit local development login opt-in (default disabled).
ALLOW_DEV_LOGIN="false"

# ===============================
# CRON JOBS
# ===============================
# Secret token to protect the /api/cron/cleanup endpoint from unauthorized calls
CRON_SECRET="your-cron-secret-token"
# Optional for a Coolify scheduled task inside the application container:
# CLEANUP_BASE_URL="http://localhost:3000"

# ===============================
# CLOUDFLARE TURNSTILE (SPAM PROTECTION)
# ===============================
# Secret key for server-side verification
TURNSTILE_SECRET_KEY="..."
# Public Site Key for the client
NEXT_PUBLIC_TURNSTILE_SITE_KEY="..."

# ===============================
# APP URL & ENVIRONMENT
# ===============================
# The base URL of your application (e.g., https://maurer-events.com)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ===============================
# ADMIN AUTH (Passwort + TOTP)
# ===============================
# Separater AES-256-GCM-Schlüssel für TOTP-Secrets at rest (min. 32 Zeichen,
# eigenständig – nicht AUTH_PEPPER/AUTH_SECRET wiederverwenden).
TOTP_ENC_KEY="replace-with-a-separate-random-key-of-at-least-32-characters"
AUTH_PEPPER="replace-with-a-separate-random-secret-of-at-least-32-characters"
# Session-Lebensdauer: Idle 24 h, absolut 30 Tage (Login = Passwort + TOTP).
SESSION_IDLE_HOURS="24"
SESSION_ABSOLUTE_DAYS="30"
STEP_UP_TTL_SECONDS="300"
ADMIN_ALLOWLIST="hello@madebylui.net,servus@maurer-events.com"
MAIL_DRY_RUN="false"

# ===============================
# AI (NVIDIA NIM)
# ===============================
# Used for automatic text translation (EN + Bairisch/bar) in the Admin panel when
# creating/editing events, gallery albums, documents and career content.
# NVIDIA NIM API key (nvapi-...). Without it, saving keeps the original German text.
NIM_API_KEY="nvapi-..."
# Optional: OpenAI-compatible NIM endpoint and model. Defaults shown below.
# The default model is a reasoning model and needs a large token budget; empty
# responses fall back to the original text (fail-open).
NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NIM_MODEL="nvidia/nemotron-3.5-super-vl-120b-a12b"
