# ---------------------------------------------------------
# MAURER EVENTS - ENVIRONMENT VARIABLES TEMPLATE
# ---------------------------------------------------------

# ===============================
# DATABASE
# ===============================
# Standard PostgreSQL URL: Neon pooled on Vercel or private PostgreSQL on Coolify.
# Use sslmode=require for external Neon; never disable TLS certificate checks.
# For migrations supply the direct (non-pooler) URL to db:migrate.
DATABASE_URL="postgres://user:password@host:port/db_name"

# ===============================
# STRIPE
# ===============================
# Stripe Secret Key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY="sk_test_..."
# Stripe Webhook Secret for validating events
STRIPE_WEBHOOK_SECRET="whsec_..."

# ===============================
# EMAIL (RESEND)
# ===============================
# API Key for sending emails via Resend
RESEND_API_KEY="re_..."
# Verified Resend sender; may use a separate verified domain for staging.
EMAIL_FROM="Maurer Events <servus@maurer-events.com>"
# Destination for contact requests; use an explicitly authorized test inbox on staging.
CONTACT_EMAIL="servus@maurer-events.com"

# ===============================
# CLOUDINARY
# ===============================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_PRESET="maurer-events-preset"

# ===============================
# AUTHENTICATION
# ===============================
# Comma-separated list of admin email addresses allowed to login
ADMIN_EMAILS="admin1@example.com,admin2@example.com"
# Random secret of at least 32 characters, used to hash one-time login codes.
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
# Explicit local development login opt-in (default disabled).
ALLOW_DEV_LOGIN="false"

# ===============================
# CRON JOBS
# ===============================
# Secret token to protect the /api/cron/cleanup endpoint from unauthorized calls
CRON_SECRET="your-cron-secret-token"
# Optional for a Coolify scheduled task inside the application container:
# CLEANUP_BASE_URL="http://localhost:3000"

# ===============================
# CLOUDFLARE TURNSTILE (SPAM PROTECTION)
# ===============================
# Secret key for server-side verification
TURNSTILE_SECRET_KEY="..."
# Public Site Key for the client
NEXT_PUBLIC_TURNSTILE_SITE_KEY="..."

# ===============================
# APP URL & ENVIRONMENT
# ===============================
# The base URL of your application (e.g., https://maurer-events.com)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ===============================
# AI (GEMINI)
# ===============================
# Used for automatic text translation (EN/DE) in the Admin panel when creating/editing events.
GEMINI_API_KEY="..."
